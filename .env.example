# ==============================================================================
# WebToAPK Environment Configuration (.env.example)
# ==============================================================================

# Database (SQLite with WAL mode by default, or PostgreSQL: postgresql+psycopg2://user:pass@host:5432/db)
DATABASE_URL=sqlite:///./data/webtoapk.db

# Android SDK & Java Environments
ANDROID_HOME=/opt/android-sdk
JAVA_HOME=/usr/lib/jvm/temurin-17-jdk-amd64
# KEYTOOL_PATH=/usr/lib/jvm/temurin-17-jdk-amd64/bin/keytool
# APKSIGNER_PATH=/opt/android-sdk/build-tools/34.0.0/apksigner

# Build Engines
DEFAULT_BUILD_ENGINE=webview
ENABLED_BUILD_ENGINES=webview

# Worker Concurrency & Build Limits
MAX_CONCURRENT_BUILDS=2
BUILD_TIMEOUT_SECONDS=600
WORKER_POLL_INTERVAL_SECONDS=0.5
HEARTBEAT_TIMEOUT_SECONDS=120
APK_RETENTION_HOURS=24

# Abuse & Rate Limiting
RATE_LIMIT_BUILDS_PER_HOUR=5
RATE_LIMIT_STATUS_PER_MINUTE=120
MAX_QUEUE_LENGTH=100
TRUST_PROXY=false
MAX_ICON_SIZE_MB=5
BLOCKLIST_PATH=./blocklist.txt

# Caching & Optimization
ENABLE_BUILD_CACHE=true

# Redis & High-Throughput Queue (optional, falls back to SQLite WAL if not set or unreachable)
REDIS_URL=redis://localhost:6379/0
QUEUE_BACKEND=auto
